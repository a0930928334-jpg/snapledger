#!/bin/sh
# Blocks commits that contain secrets. Enable once per clone:
#   git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks is not installed (https://github.com/gitleaks/gitleaks#installing)." >&2
    echo "pre-commit: refusing to commit without a secret scan." >&2
    exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner --verbose
